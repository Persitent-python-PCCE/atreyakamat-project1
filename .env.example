# ==============================================================================
# SeatMeUp — Environment Configuration Template
# Copy this file to '.env' and fill in your real values.
# NEVER commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# Application Environment ('development', 'testing', or 'production')
FLASK_ENV=production

# Application Base URL (Required for public Cloudflare domain / live ticket links)
# Example: https://seatmeup.yourdomain.com
APP_BASE_URL=https://seatmeup.yourdomain.com

# ------------------------------------------------------------------------------
# Security Keys (REQUIRED in Production — Generate strong random 64-char strings)
# E.g.: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------------------------
SECRET_KEY=replace_with_a_secure_random_production_secret_key_minimum_32_chars
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_minimum_32_chars

# ------------------------------------------------------------------------------
# Database Configuration (MySQL)
# Provide either DATABASE_URL or individual DB_* credentials.
# ------------------------------------------------------------------------------
DATABASE_URL=mysql+pymysql://seatmeup_user:your_secure_db_password@localhost:3306/seatmeup

# Alternatively, configure individual parameters:
DB_USER=seatmeup_user
DB_PASSWORD=your_secure_db_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=seatmeup

# ------------------------------------------------------------------------------
# Reverse Proxy / Cloudflare Tunnel Support
# Set to 'true' when running behind Cloudflare Tunnel / Gunicorn.
# ------------------------------------------------------------------------------
USE_PROXY_FIX=true

# Secure Cookies (Set to 'true' in HTTPS production; set to 'false' only for local HTTP debugging)
COOKIE_SECURE=true

# ------------------------------------------------------------------------------
# Outbound Email Configuration (Gmail SMTP for Booking Tickets & PDF Attachments)
# Generate an App Password via Google Account -> Security -> 2-Step Verification -> App Passwords
# ------------------------------------------------------------------------------
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
MAIL_USE_TLS=true
